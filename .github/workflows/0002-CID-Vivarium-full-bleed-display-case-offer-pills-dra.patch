From 6dd5c801d31c2615d139f2b895a699c3e0d39394 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 16 Aug 2026 10:19:07 +0000
Subject: [PATCH 2/5] CID Vivarium: full-bleed display case, offer pills, draft
 research drivers

Display case:
- .cid-vault breaks out of the text column to 100vw so the vitrine reads as
  a room you stand in front of rather than a figure set into the copy.
  Break-out uses the calc(50% - 50vw) form, which survives being a flex
  item of .cid-viv-stack; .cid-viv gets overflow-x: clip so the scrollbar
  width cannot become a horizontal scroll.
- The room, mullion and era comparison are capped at 1500px inside the
  shell, so the era copy holds its measure and the vanta-black shell reads
  as museum surround on a wide screen. Corner blocks lose their 18px radius
  now that the shell is square to the viewport.

Copy, per Greg:
- Digital Products drops "Radical Strategic Intelligence" and replaces
  "AI Experiments" with "Experimental Research Design".
- New research drivers block under Leadership, set verbatim and carrying a
  removable "Draft copy, not approved" flag per the Habitat display plan.
  The four cooperation modes are a definition list so no acronym appears
  without its meaning.

Flagged for Greg, not silently corrected: "Our research are driven by",
and whether "B20" should read "B2O".

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EvRZJin2PNdFtPMRwTJCdt
---
 src/app/components/CID.tsx  | 27 +++++++++++++--
 src/styles/cid-vivarium.css | 65 +++++++++++++++++++++++++++++++++----
 2 files changed, 83 insertions(+), 9 deletions(-)

diff --git a/src/app/components/CID.tsx b/src/app/components/CID.tsx
index 897e61c..03ea118 100644
--- a/src/app/components/CID.tsx
+++ b/src/app/components/CID.tsx
@@ -586,13 +586,36 @@ export function CID({ onSupport }: { onSupport: () => void }) {
                   <li>Pursue research imperatives set by <span className="cid-ooo">Ooo!</span> Digital Media Studio</li>
                 </ul>
 
+                {/* Greg's supplied wording, set verbatim and marked DRAFT per
+                    the Habitat display plan's guardrail: draft copy lives in
+                    named slots behind a flag that is easy to remove. Two
+                    things flagged back to him rather than silently corrected:
+                    "Our research are driven by", and whether "B20" is meant
+                    to be "B2O" for business to organization. The four
+                    cooperation modes are set as a definition list so every
+                    acronym sits with its meaning, per the house rule. */}
+                <div className="cid-viv-drivers">
+                  <p className="cid-viv-draft-flag">Draft copy, not approved</p>
+                  <p className="cid-viv-lead">Our research are driven by</p>
+                  <ul className="cid-viv-lead-list">
+                    <li><strong>Radical Strategic Intelligence</strong></li>
+                    <li><strong>Collective problem solving</strong></li>
+                    <li><strong>Creative Cooperation</strong></li>
+                  </ul>
+                  <dl className="cid-viv-coop">
+                    <div><dt>B2B</dt><dd>Business to Business</dd></div>
+                    <div><dt>B2G</dt><dd>Business to Government</dd></div>
+                    <div><dt>P2P</dt><dd>Peer to Peer</dd></div>
+                    <div><dt>B20</dt><dd>Business to Organization</dd></div>
+                  </dl>
+                </div>
+
                 {/* Digital products and studio services offered by CID. */}
                 <div className="cid-viv-offer">
                   <div className="cid-viv-offer-row">
                     <p className="cid-viv-offer-label">Digital Products</p>
                     <div className="cid-viv-offer-pills">
-                      <span className="cid-viv-pill">Radical Strategic Intelligence</span>
-                      <span className="cid-viv-pill">AI Experiments</span>
+                      <span className="cid-viv-pill">Experimental Research Design</span>
                       <span className="cid-viv-pill">AI4XD</span>
                       <span className="cid-viv-pill">Data Viz</span>
                     </div>
diff --git a/src/styles/cid-vivarium.css b/src/styles/cid-vivarium.css
index e523dd6..628eba7 100644
--- a/src/styles/cid-vivarium.css
+++ b/src/styles/cid-vivarium.css
@@ -4,7 +4,11 @@
    light robin's-egg canvas. Scoped under .cid-scope like the rest of the
    CID page. */
 
-.cid-scope .cid-viv { background: #F0F4F5; padding: clamp(30px,5vh,56px) 0 clamp(34px,6vh,64px); }
+/* overflow-x: clip contains the full-bleed .cid-vault band (100vw) so the
+   scrollbar's width cannot turn into a horizontal scroll. clip rather than
+   hidden: it does not create a scroll container, so nothing inside is
+   trapped or made scrollable. */
+.cid-scope .cid-viv { background: #F0F4F5; padding: clamp(30px,5vh,56px) 0 clamp(34px,6vh,64px); overflow-x: clip; }
 .cid-scope .cid-viv-stack { display: flex; flex-direction: column; gap: clamp(22px,3.4vh,34px); }
 
 /* Prose blocks read as one crisp shape, not three ragged edges: text-wrap
@@ -427,9 +431,18 @@
   --vault-petrol: 14, 58, 86;
   --vault-teal: 14, 110, 115;
   --vault-nacre: 111, 195, 249;
+  /* The vitrine escapes the text column and runs the full width of the
+     viewport, so the room reads as something you stand in front of rather
+     than a figure set into the copy. Break-out matches .cid-wl-hero; the
+     calc() form survives being a flex item of .cid-viv-stack. The inner
+     compartments are capped again below, which keeps the era copy on a
+     readable measure and leaves the vanta-black shell as the museum
+     surround on wide screens. */
+  width: 100vw; max-width: none;
+  margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw);
   position: relative; isolation: isolate;
-  padding: clamp(13px,1.5vw,20px);
-  border-radius: 18px;
+  padding: clamp(13px,1.5vw,20px) clamp(16px,3vw,48px);
+  border-radius: 0;
   background:
     /* shadow side: light falls from above, so depth gathers at the foot */
     linear-gradient(172deg, rgba(var(--vault-petrol),.20) 0%, transparent 34%, transparent 62%, rgba(var(--vault-petrol),.15) 100%),
@@ -451,6 +464,15 @@
   background: linear-gradient(104deg, transparent 18%, rgba(var(--vault-nacre),.05) 33%, transparent 44%);
 }
 .cid-scope .cid-vault > * { position: relative; z-index: 1; }
+/* Inner compartments stay on a readable width inside the full-bleed shell:
+   the room gets far more room than the old column allowed, and the era copy
+   keeps its measure instead of stretching to the viewport on a wide screen.
+   The corner blocks are absolute to the shell, so they stay at its edges. */
+.cid-scope .cid-vault > .cid-vivroom,
+.cid-scope .cid-vault > .cid-vault-mullion,
+.cid-scope .cid-vault > .cid-viv-era {
