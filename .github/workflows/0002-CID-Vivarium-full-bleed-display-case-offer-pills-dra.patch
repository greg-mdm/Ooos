+}
 
 /* Mitred titanium corner blocks. Sharp, structural, and the only place the
    shell reads as machined metal. */
@@ -463,10 +485,10 @@
   clip-path: polygon(0 0, 34px 0, 26px 8px, 8px 8px, 8px 26px, 0 34px);
   box-shadow: 0 0 12px -2px rgba(var(--vault-nacre),.3);
 }
-.cid-scope .cid-vault-corner--tl { top: -1px; left: -1px; border-top-left-radius: 18px; }
-.cid-scope .cid-vault-corner--tr { top: -1px; right: -1px; transform: scaleX(-1); border-top-left-radius: 18px; }
-.cid-scope .cid-vault-corner--bl { bottom: -1px; left: -1px; transform: scaleY(-1); border-top-left-radius: 18px; }
-.cid-scope .cid-vault-corner--br { bottom: -1px; right: -1px; transform: scale(-1,-1); border-top-left-radius: 18px; }
+.cid-scope .cid-vault-corner--tl { top: -1px; left: -1px; }
+.cid-scope .cid-vault-corner--tr { top: -1px; right: -1px; transform: scaleX(-1); }
+.cid-scope .cid-vault-corner--bl { bottom: -1px; left: -1px; transform: scaleY(-1); }
+.cid-scope .cid-vault-corner--br { bottom: -1px; right: -1px; transform: scale(-1,-1); }
 @media (max-width: 700px) {
   .cid-scope .cid-vault-corner { width: 24px; height: 24px; clip-path: polygon(0 0, 24px 0, 18px 6px, 6px 6px, 6px 18px, 0 24px); }
 }
@@ -788,3 +810,32 @@
   font-size: 13.5px; line-height: 1.6; color: #5b5f86;
 }
 .cid-scope .cid-viv-disc strong { display: block; max-width: 70ch; color: #5b5f86; font-weight: 700; }
+
+/* ---- Research drivers: the three things the work is driven by, with the
