                   enclosure rather than two blocks sitting loose on the page:
                   vanta-black steel shell, mitred titanium corner blocks, and a
diff --git a/src/styles/cid-vivarium.css b/src/styles/cid-vivarium.css
index 628eba7..0444d25 100644
--- a/src/styles/cid-vivarium.css
+++ b/src/styles/cid-vivarium.css
@@ -839,3 +839,47 @@
 @media (max-width: 620px) {
   .cid-scope .cid-viv-coop { grid-template-columns: minmax(0, 1fr); }
 }
+
+/* ---- Strategies: the three pillars, below Leadership and above the Viv
+   display case. The keys themselves are the homepage's .ood-key design,
+   imported unchanged from ooodivisions2.css so the two places stay one
+   system; everything here is the surround plus the two-bullet split inside
+   each key, which the homepage keys do not have. ---- */
+.cid-scope .cid-strategy { display: flex; flex-direction: column; gap: 10px; }
+.cid-scope .cid-strategy-eyebrow {
+  margin: 0;
+  font-family: 'Montserrat', system-ui, sans-serif; font-weight: 800; font-size: 11px;
+  letter-spacing: .22em; text-transform: uppercase; color: #822F00;
+}
+.cid-scope .cid-strategy-h {
+  margin: 0;
+  font-family: 'Montserrat', system-ui, sans-serif; font-weight: 800;
+  font-size: clamp(20px,2.4vw,28px); line-height: 1.18; letter-spacing: -.01em;
+  color: #1a1646; max-width: 24ch; text-wrap: balance;
+}
+.cid-scope .cid-strategy-sub {
+  margin: 0 0 4px; font-size: clamp(15px,1.5vw,18px); line-height: 1.55; color: #33384a;
+}
+/* Three across, since these read as pillars rather than a stacked list.
+   Stretch so the keys share one height however the bullets wrap. */
+.cid-scope .cid-strategy-keys {
+  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: clamp(12px,1.6vw,18px); align-items: stretch;
+}
+.cid-scope .cid-strategy-keys .ood-key-wrap { height: 100%; }
+.cid-scope .cid-strategy-keys .ood-key { height: 100%; align-items: flex-start; }
+/* Two statements, two bullets. The marker is drawn rather than a list-style
+   so it keeps the Bright Silver legend's colour and sits on the cap height. */
+.cid-scope .cid-strategy-bullets { display: flex; flex-direction: column; gap: 7px; }
+.cid-scope .cid-strategy-bullet {
+  position: relative; padding-left: 18px; display: block;
+}
+.cid-scope .cid-strategy-bullet::before {
+  content: ""; position: absolute; left: 0; top: .55em;
+  width: 7px; height: 7px; border-radius: 2px;
+  background: #E8ECF4; opacity: .85;
+}
+@media (max-width: 860px) {
+  .cid-scope .cid-strategy-keys { grid-template-columns: minmax(0, 1fr); }
+  .cid-scope .cid-strategy-keys .ood-key { align-items: center; }
+}
